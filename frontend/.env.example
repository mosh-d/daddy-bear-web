# Copy to .env.local for development. For production, set these in
# Cloudflare Pages -> your project -> Settings -> Environment variables.
#
# All of these are baked into the site when it's built (it's a static
# export; there is no server to read them later), so after changing one in
# Cloudflare, trigger a new deployment. Anything left unset hides its
# feature instead of shipping a broken link or embed. See SETUP.md.
#
# Note: the newsletter (Substack), social links and contact email are not
# here — they're public brand links kept in content/links.ts.

# Public site URL, used for share links, the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=https://daddybear.ng

# WhatsApp Channel invite link (https://whatsapp.com/channel/...).
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=

# WhatsApp number for click-to-chat, in international format
# (2348012345678). A local number (08012345678) is converted automatically.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Host-a-screening form: Tally. The form ID (e.g. wA1b2C) or any
# tally.so/r/... link to the form.
NEXT_PUBLIC_TALLY_FORM_ID=

# Analytics: set one (or both). Cloudflare Web Analytics is cookie-free and
# is the recommended option; GA4 sets cookies. Whichever you set is named
# automatically in the published privacy policy.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
NEXT_PUBLIC_GA4_ID=

# cardinalstudio.ng link in the footer, if different from the default.
NEXT_PUBLIC_CARDINAL_STUDIO_URL=https://cardinalstudio.ng
