# Cloudflare Pages response headers. See https://developers.cloudflare.com/pages/configuration/headers/

# Next.js fingerprints everything under /_next/static (the file name changes
# whenever the content does), so returning visitors never re-download it.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
